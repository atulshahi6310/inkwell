<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= post.username %>'s Story — Inkwell
    </title>
    <link rel="stylesheet" href="/show.css">
</head>

<body>

    <a href="/posts" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Stories
    </a>

    <article class="post">
        <div class="post-id-badge">
            🪪 &nbsp;Post ID: <%= post.id.slice(0, 8) %>…
        </div>

        <div class="author-row">
            <div class="avatar-lg">
                <%= post.username.charAt(0) %>
            </div>
            <div class="author-info">
                <div class="author-name">
                    <%= post.username %>
                </div>
            </div>
        </div>

        <div class="post-content">
            <%= post.content %>
        </div>

        <div class="post-meta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            Published on <%= post.timestamp %>
        </div>

        <div class="post-actions">
            <a href="/posts/<%= post.id %>/edit" class="btn btn-primary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                Edit Story
            </a>
            <a href="/posts" class="btn btn-outline">All Stories</a>
        </div>
    </article>

</body>

</html>