<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write a Story — Inkwell</title>
    <link rel="stylesheet" href="/form.css">
</head>

<body>

    <a href="/posts" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Stories
    </a>

    <div class="form-card">
        <div class="form-header">
            <span class="form-tag">✒ New Story</span>
            <h1>Share your thoughts</h1>
            <p>Write something wonderful and publish it for everyone to see.</p>
        </div>

        <form method="POST" action="/post">
            <div class="form-group">
                <label for="username">Author Name</label>
                <input class="form-control" type="text" id="username" name="username" placeholder="e.g. Jane Smith"
                    required autocomplete="off">
            </div>

            <div class="form-group">
                <label for="content">Your Story</label>
                <textarea class="form-control" id="content" name="content" placeholder="Start writing your story here…"
                    rows="7" required></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    Publish Story
                </button>
                <a href="/posts" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>

</body>

</html>